{
  "name": "sqlite-nas-sync",
  "version": "0.18.0",
  "description": "Sync SQLite databases across multiple clients via NAS with changelog-based conflict resolution",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test:watch": "vitest",
    "docs": "typedoc",
    "docs:serve": "typedoc && npx serve docs/api -l 3333",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sqlite",
    "nas",
    "sync",
    "database",
    "conflict-resolution",
    "multi-client",
    "changelog"
  ],
  "author": "KeppyNaushika",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KeppyNaushika/sqlite-nas-sync.git"
  },
  "bugs": {
    "url": "https://github.com/KeppyNaushika/sqlite-nas-sync/issues"
  },
  "homepage": "https://github.com/KeppyNaushika/sqlite-nas-sync#readme",
  "peerDependencies": {
    "better-sqlite3": ">=11.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=16.0.0"
  }
}
